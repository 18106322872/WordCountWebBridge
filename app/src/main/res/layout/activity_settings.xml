<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WordCount 网页版 · 桥接设置"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- v1.1.6：版本号（设置页可见、不透明常规文字） -->
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"
        android:text="版本" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="统计网址（从微信/千牛打开文件时，会传到这个网址统计）："
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cb_auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自动发现网址（开启后忽略下方下拉框，用服务器发布域名）"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/sp_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_def"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="frp 访问密码（可选）："
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_pw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:hint="frp 链接已开访问密码时填，留空则需浏览器先授权一次" />

    <CheckBox
        android:id="@+id/cb_word_verify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Word 精确模式（默认开启：统计更准但稍慢）"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存网址" />

    <Button
        android:id="@+id/btn_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开网页统计"
        android:layout_marginTop="8dp" />
</LinearLayout>
